+def frame_to_view(frame_hw, view_hw) -> tuple[float, float, float]:
+    """Frame pixels -> model view pixels: MapAnything resizes by max(scale) and centre-crops (verified to 1 px,
+    WORKLOG E18). Returns (scale, x offset, y offset): view = frame * scale - offset."""
+    H, W = frame_hw
+    Hd, Wd = view_hw
+    s = max(Wd / W, Hd / H)
+    return s, (W * s - Wd) / 2, (H * s - Hd) / 2
+
+
+def content_mask(frame_hw, view_hw, box) -> np.ndarray:
+    """View pixels that show the frame's content box (x0, y0, x1, y1), 1 px in from a padded black edge."""
+    s, ox, oy = frame_to_view(frame_hw, view_hw)
+    x0, y0, x1, y1 = box
+    u, v = np.arange(view_hw[1]) + 0.5, np.arange(view_hw[0]) + 0.5
+    inx = (u >= x0 * s - ox + 1) & (u <= x1 * s - ox - 1)
+    iny = (v >= y0 * s - oy + 1) & (v <= y1 * s - oy - 1)
+    return iny[:, None] & inx[None, :]
+
+
 def ray_K(views: dict[str, np.ndarray], i: int, rays: str) -> np.ndarray:
     """Intrinsics consistent with view_points(views, i, rays): the model's for rays='model' (video,
     E22c), EXIF for rays='exif'. Anything that projects into a view or back out of it must use these."""
