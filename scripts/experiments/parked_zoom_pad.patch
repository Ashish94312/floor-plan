diff --git a/tests/unit/test_orientation_pad.py b/tests/unit/test_orientation_pad.py
new file mode 100644
index 0000000..c194d6f
--- /dev/null
+++ b/tests/unit/test_orientation_pad.py
@@ -0,0 +1,52 @@
+"""Mixed orientation in one joint photo run: the minority is padded, not cropped (home01_photo_b kitchen)."""
+
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+
+from scan.geometry.cloud import content_mask
+from scan.io.photos import pad_to_aspect_of
+from scan.pipeline import pad_mixed_orientation
+from scan.types import Frame
+
+
+def _frame(h, w, room="r", seed=0):
+    rgb = np.random.default_rng(seed).integers(1, 256, (h, w, 3), dtype=np.uint8)
+    K = np.array([[10.0, 0, w / 2], [0, 10.0, h / 2], [0, 0, 1]])
+    return Frame(image_path=Path(f"{room}_{seed}.jpg"), K=K, rgb=rgb, room_hint=room)
+
+
+def test_portrait_padded_to_landscape_keeps_content_and_rays():
+    f = _frame(8, 6)
+    g, box = pad_to_aspect_of(f, 8, 6)
+    assert g.rgb.shape == (8, 11, 3) and box == (2, 0, 8, 8)
+    assert np.array_equal(g.rgb[:, 2:8], f.rgb) and not g.rgb[:, :2].any() and not g.rgb[:, 8:].any()
+    # pixel u on the original and u + 2 on the canvas look along the same ray
+    u, v = 1.5, 3.5
+    assert np.allclose(np.linalg.solve(f.K, [u, v, 1]), np.linalg.solve(g.K, [u + 2, v, 1]))
+
+
+def test_content_mask_excludes_padding():
+    m = content_mask((8, 11), (8, 11), (2, 0, 8, 8))
+    assert m[1:7, 3:7].all()
+    assert not m[:, :3].any() and not m[:, 7:].any() and not m[0].any() and not m[7].any()
+
+
+def test_minority_orientation_padded_in_capture():
+    land = [_frame(6, 8, "bedroom1", s) for s in range(3)]
+    port = [_frame(8, 6, "kitchen", s) for s in range(2)]
+    cap = SimpleNamespace(rooms={"bedroom1": list(land), "kitchen": list(port)}, warnings=[])
+    frames, boxes = pad_mixed_orientation(cap, land + port)
+    assert sorted(boxes) == [3, 4]
+    assert all(f.rgb.shape == (8, 11, 3) for f in frames[3:])
+    assert all(f is g for f, g in zip(frames[:3], land))
+    assert all(a is b for a, b in zip(cap.rooms["kitchen"], frames[3:]))  # the detector sees the padded image
+    assert "kitchen (2): portrait photos in a landscape joint run" in cap.warnings[0]
+
+
+def test_one_orientation_untouched():
+    land = [_frame(6, 8, "bedroom1", s) for s in range(3)]
+    cap = SimpleNamespace(rooms={"bedroom1": list(land)}, warnings=[])
+    frames, boxes = pad_mixed_orientation(cap, land)
+    assert frames is land and boxes == {} and cap.warnings == []
