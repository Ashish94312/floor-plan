+def pad_mixed_orientation(cap: Capture, frames: list) -> tuple[list, dict[int, tuple]]:
+    """One joint photo run over rooms shot in different orientations: the minority orientation is padded to the
+    majority's aspect (pad_to_aspect_of) instead of being cropped by the model's batching. The padded frames replace
+    the originals in cap.rooms, so the detector sees the image the model saw. -> (frames, {view index: box})."""
+    portrait = [f.rgb.shape[0] > f.rgb.shape[1] for f in frames]
+    n = sum(portrait)
+    if n in (0, len(frames)):
+        return frames, {}
+    major = n > len(frames) - n  # majority portrait? A tie goes to landscape, the protocol's orientation
+    ref = next(f for f, p in zip(frames, portrait) if p == major)
+    out, boxes, rooms = list(frames), {}, {}
+    for i, (f, p) in enumerate(zip(frames, portrait)):
+        if p == major:
+            continue
+        out[i], boxes[i] = pad_to_aspect_of(f, ref.rgb.shape[1], ref.rgb.shape[0])
+        room = cap.rooms[f.room_hint]
+        room[next(j for j, x in enumerate(room) if x is f)] = out[i]
+        rooms[f.room_hint] = rooms.get(f.room_hint, 0) + 1
+    other, run = ("landscape", "portrait") if major else ("portrait", "landscape")
+    cap.warnings.append(f"{', '.join(f'{r} ({k})' for r, k in rooms.items())}: {other} photos in a {run} joint run, "
+                        f"padded to {run} (not cropped); the protocol says landscape")
+    return out, boxes
+
