+++ b/scripts/experiments/e23_zoom_pad_ablation.py
@@ -0,0 +1,32 @@
+"""E23b: which of two input changes moved home01_photo_b: the digital zoom in K, or padding the portrait kitchen?
+
+Runs the pipeline with one change switched off (monkeypatched), level off (vote only), then scan-eval.
+
+    uv run python scripts/experiments/e23_zoom_pad_ablation.py {zoom_only|pad_only|neither}
+"""
+
+import subprocess
+import sys
+from pathlib import Path
+
+import scan.io.photos as photos
+import scan.pipeline as pipeline
+from scan.config import load_config
+
+case = sys.argv[1]
+cap = Path("captures/home01_photo_b")
+out = cap / "experiments" / f"E23b_{case}"
+
+if case in ("pad_only", "neither"):  # no zoom: the EXIF tag says 1.0
+    orig = photos._exif
+    photos._exif = lambda im: {**orig(im), "digital_zoom": None}
+if case in ("zoom_only", "neither"):  # no padding: the model's batching crops as before
+    pipeline.pad_mixed_orientation = lambda cap, frames: (frames, {})
+
+cfg = load_config(overrides={"uncertainty": {"apply_scale_bias": False}})
+pipeline.run(cap, cfg, out=out, log=lambda s: print(s) if "scale vote" in s or "warning" in s and "zoom" not in s else None)
+subprocess.run(["uv", "run", "scan-eval", str(out), "--gt", "data/ground_truth/home01.yaml"], check=True,
+               stdout=subprocess.DEVNULL)
+for line in (out / "eval.md").read_text().splitlines():
+    if line.startswith(("| bedroom1-W", "| kitchen-W", "- ceiling", "## ", "Walls scored")):
+        print(line)
