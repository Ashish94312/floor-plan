+def pad_to_aspect_of(frame: Frame, W_ref: int, H_ref: int) -> tuple[Frame, tuple[int, int, int, int]]:
+    """A photo whose orientation differs from the rest of a joint run, centred on a black canvas of the run's aspect
+    (W_ref x H_ref). MapAnything resizes and centre-crops every view to one batch shape, which cut a portrait photo
+    among landscape ones to its middle ~57% (no floor, no ceiling: home01_photo_b kitchen). On the canvas all of it
+    is kept; rays stay true (only the principal point moves). Returns the padded frame and its content box
+    (x0, y0, x1, y1) on the canvas."""
+    h, w = frame.rgb.shape[:2]
+    a = W_ref / H_ref
+    Wc, Hc = max(w, round(h * a)), max(h, round(w / a))
+    x0, y0 = (Wc - w) // 2, (Hc - h) // 2
+    canvas = np.zeros((Hc, Wc, 3), np.uint8)
+    canvas[y0:y0 + h, x0:x0 + w] = frame.rgb
+    K = frame.K.copy()
+    K[0, 2] += x0
+    K[1, 2] += y0
+    return dataclasses.replace(frame, rgb=canvas, K=K), (x0, y0, x0 + w, y0 + h)
+
+
